# Copy to .env.local and fill in your values.
#
# For local development the Cloud Agent / dev setup generates .env.local
# automatically from the local Supabase stack (see scripts/write-local-env.sh).
# The values below are the well-known local Supabase defaults.

# Supabase (required) — from `supabase status` or your project's API settings
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL used for auth redirects and notifications
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Domain Developer API (optional) — powers `npm run sync:domain`
# DOMAIN_CLIENT_ID=
# DOMAIN_CLIENT_SECRET=
# DOMAIN_SYNC_SECRET=

# Email notifications (optional)
# FEATURE_EMAIL_NOTIFICATIONS=false
# SENDGRID_API_KEY=
