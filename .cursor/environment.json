{
  "name": "Velu MVP",
  "install": "bash scripts/cloud-agent-install.sh",
  "start": "bash scripts/cloud-agent-start.sh",
  "terminals": [
    {
      "name": "dev",
      "command": "bash scripts/cloud-agent-start.sh && npm run dev",
      "description": "Ensures the local Supabase backend is up (idempotent), then runs the Next.js dev server on http://localhost:3000"
    }
  ],
  "ports": [
    { "name": "web", "port": 3000 },
    { "name": "supabase-api", "port": 54321 },
    { "name": "supabase-studio", "port": 54323 }
  ]
}
